rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} { allow read, write: if false; }

    function isSignedIn() { return request.auth != null; }
    function isValidId(id) { return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    
    function isValidUser(data) {
      return data.keys().hasAll(['email'])
        && data.email is string && data.email.size() <= 256
        && (!data.keys().hasAny(['gamertag']) || (data.gamertag is string && data.gamertag.size() <= 50))
        && (!data.keys().hasAny(['photoURL']) || (data.photoURL is string && data.photoURL.size() <= 1024))
        && (!data.keys().hasAny(['bannerURL']) || (data.bannerURL is string && data.bannerURL.size() <= 1024))
        && (!data.keys().hasAny(['bio']) || (data.bio is string && data.bio.size() <= 500));
    }

    match /users/{userId} {
      allow read: if isSignedIn() && isValidId(userId);
      allow create: if isSignedIn() && request.auth.uid == userId && isValidUser(incoming());
      allow update: if isSignedIn() && request.auth.uid == userId && isValidUser(incoming());
    }

    function isValidFollow(data) {
      return data.keys().hasAll(['followerId', 'followingId', 'createdAt'])
        && data.keys().size() == 3
        && data.followerId is string && data.followerId.size() <= 128
        && data.followingId is string && data.followingId.size() <= 128
        && data.followerId == request.auth.uid
        && data.createdAt == request.time;
    }

    match /follows/{followId} {
      allow read: if isSignedIn() && isValidId(followId);
      allow list: if isSignedIn(); // We do list queries by followingId and followerId
      allow create: if isSignedIn() && isValidId(followId) 
        && isValidFollow(incoming())
        && followId == (request.auth.uid + '_' + incoming().followingId);
      allow delete: if isSignedIn() && isValidId(followId) && existing().followerId == request.auth.uid;
    }

    function isValidNotificationCreate(data) {
      return data.keys().hasAll(['userId', 'senderId', 'type', 'createdAt', 'read'])
        && data.keys().size() == 5
        && data.userId is string && data.userId.size() <= 128
        && data.senderId is string && data.senderId.size() <= 128
        && data.senderId == request.auth.uid
        && data.type is string && data.type in ['follow', 'like', 'comment']
        && data.createdAt == request.time
        && data.read is bool && data.read == false;
    }

    match /notifications/{notificationId} {
      allow read: if isSignedIn() && existing().userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidId(notificationId) && isValidNotificationCreate(incoming());
      allow update: if isSignedIn() && isValidId(notificationId) 
        && existing().userId == request.auth.uid 
        && incoming().diff(existing()).affectedKeys().hasOnly(['read'])
        && incoming().read is bool;
      allow delete: if isSignedIn() && isValidId(notificationId) && existing().userId == request.auth.uid;
    }
  }
}
