rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} { allow read, write: if false; }

    function isSignedIn() { return request.auth != null; }
    function isValidId(id) { return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    
    function isAdmin() {
      return isSignedIn() && request.auth.token.email == 'samuelsomiahbiz@gmail.com';
    }

    function isValidUser(data) {
      return data.keys().hasAll(['email'])
        && data.email is string && data.email.size() <= 256
        && (!data.keys().hasAny(['name']) || data.name == null || (data.name is string && data.name.size() <= 100))
        && (!data.keys().hasAny(['gamertag']) || data.gamertag == null || (data.gamertag is string && data.gamertag.size() <= 50))
        && (!data.keys().hasAny(['gamertagLower']) || data.gamertagLower == null || (data.gamertagLower is string && data.gamertagLower.size() <= 50))
        && (!data.keys().hasAny(['photoURL']) || data.photoURL == null || (data.photoURL is string && data.photoURL.size() <= 250000))
        && (!data.keys().hasAny(['bannerURL']) || data.bannerURL == null || (data.bannerURL is string && data.bannerURL.size() <= 250000))
        && (!data.keys().hasAny(['bio']) || data.bio == null || (data.bio is string && data.bio.size() <= 500))
        && (!data.keys().hasAny(['country']) || data.country == null || (data.country is string && data.country.size() <= 100))
        && (!data.keys().hasAny(['platforms']) || (data.platforms is list))
        && (!data.keys().hasAny(['games']) || (data.games is list))
        && (!data.keys().hasAny(['createdAt']) || (data.createdAt is string));
    }

    match /users/{userId} {
      allow read: if isSignedIn() && isValidId(userId);
      allow list: if isSignedIn(); // Required for search queries
      allow create: if isSignedIn() && request.auth.uid == userId && isValidUser(incoming());
      allow update: if isSignedIn() && request.auth.uid == userId && isValidUser(incoming());
      allow delete: if isAdmin() || (isSignedIn() && request.auth.uid == userId);
    }

    function isValidFollow(data) {
      return data.keys().hasAll(['followerId', 'followingId', 'createdAt'])
        && data.keys().size() == 3
        && data.followerId is string && data.followerId.size() <= 128
        && data.followingId is string && data.followingId.size() <= 128
        && data.followerId == request.auth.uid
        && data.createdAt == request.time;
    }

    match /follows/{followId} {
      allow read: if isSignedIn() && isValidId(followId);
      allow list: if isSignedIn(); // Required to query follower/following counts
      allow create: if isSignedIn() && isValidId(followId) 
        && isValidFollow(incoming())
        && followId == (request.auth.uid + '_' + incoming().followingId);
      allow delete: if isAdmin() || (isSignedIn() && isValidId(followId) && existing().followerId == request.auth.uid);
    }

    function isValidNotificationCreate(data) {
      return data.keys().hasAll(['userId', 'senderId', 'type', 'createdAt', 'read'])
        && data.keys().size() == 5
        && data.userId is string && data.userId.size() <= 128
        && data.senderId is string && data.senderId.size() <= 128
        && data.senderId == request.auth.uid
        && data.type is string && data.type in ['follow', 'like', 'comment']
        && data.createdAt == request.time
        && data.read is bool && data.read == false;
    }

    match /notifications/{notificationId} {
      allow read: if isSignedIn() && (isAdmin() || existing().userId == request.auth.uid);
      allow list: if isSignedIn() && (isAdmin() || resource.data.userId == request.auth.uid);
      allow create: if isSignedIn() && isValidId(notificationId) && isValidNotificationCreate(incoming());
      allow update: if isSignedIn() && isValidId(notificationId) 
        && existing().userId == request.auth.uid 
        && incoming().diff(existing()).affectedKeys().hasOnly(['read'])
        && incoming().read is bool;
      allow delete: if isAdmin() || (isSignedIn() && isValidId(notificationId) && existing().userId == request.auth.uid);
    }
  }
}
